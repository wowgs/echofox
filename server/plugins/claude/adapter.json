{
  "name": "claude",
  "version": "1.0",
  "author": "local-voice",
  "source": "https://github.com/wowgs/local-voice",
  "description": "Reads the Claude Code session open in the Code tab of Claude Desktop.",
  "interface": 2,
  "apps": [
    "com.anthropic.claudefordesktop"
  ],
  "electronTree": true,
  "reads": [
    "~/Library/Application Support/Claude/claude-code-sessions",
    "~/.claude/projects"
  ],
  "context": {
    "chatHistoryTokenBudget": 1000,
    "chatTermsTokenBudget": 200
  }
}
