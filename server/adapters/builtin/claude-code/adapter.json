{
  "name": "claude-code",
  "title": "Claude Code",
  "version": "3.0",
  "author": "echofox",
  "source": "https://github.com/wowgs/echofox",
  "description": "Reads the transcript of the Claude Code session in focus: the Code tab of Claude Desktop, or a terminal's tab. In the Code tab it also reads the Markdown file open beside the chat.",
  "interface": 3,
  "surfaces": [
    {
      "id": "desktop",
      "title": "Claude Desktop, Code tab",
      "apps": ["com.anthropic.claudefordesktop"],
      "treeOnRequest": true,
      "match": {"url": "https://claude.ai/epitaxy/*"},
      "screen": {"outline": {"skip": ["epitaxy-document-page", "group/file-tree", "epitaxy-chat-panel-body"]}},
      "reads": [
        {"path": "~/Library/Application Support/Claude/claude-code-sessions", "what": "The session's record"},
        {"path": "~/.claude/projects", "what": "The session's transcript"},
        {"what": "The Markdown file open in the Files panel, from the session's folder"}
      ]
    },
    {
      "id": "terminal",
      "title": "Terminal tab",
      "apps": ["com.mitchellh.ghostty", "com.apple.Terminal", "com.googlecode.iterm2", "dev.warp.Warp-Stable"],
      "screen": {"processes": {}},
      "reads": [
        {"path": "~/.claude/sessions", "what": "The running sessions"},
        {"path": "~/.claude/projects", "what": "The session's transcript"}
      ]
    }
  ],
  "context": {
    "chatHistoryTokenBudget": 1000,
    "chatTermsTokenBudget": 200
  }
}
