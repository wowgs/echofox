{
  "name": "claude-chat",
  "title": "Claude chats",
  "version": "3.0",
  "author": "echofox",
  "source": "https://github.com/wowgs/echofox",
  "description": "Reads the chat open in Claude Desktop, from the outline of the page that the window shows.",
  "interface": 3,
  "surfaces": [
    {
      "id": "desktop",
      "title": "Claude Desktop, chats",
      "apps": ["com.anthropic.claudefordesktop"],
      "treeOnRequest": true,
      "match": {"url": "https://claude.ai/chat/*"},
      "screen": {"outline": {"skip": ["AXButton", "sr-only", "group/morph", "group/tag"], "budget": "chatHistoryTokenBudget"}},
      "reads": []
    }
  ],
  "context": {
    "chatHistoryTokenBudget": 1000,
    "chatTermsTokenBudget": 200
  }
}
