{
  "name": "claude-chat",
  "title": "Claude chats",
  "version": "2.1",
  "author": "echofox",
  "source": "https://github.com/wowgs/echofox",
  "description": "Reads the chat open in Claude Desktop, from the outline of the page that the window shows.",
  "interface": 2,
  "apps": [
    "com.anthropic.claudefordesktop"
  ],
  "electronTree": true,
  "reads": [],
  "screen": [
    "outline"
  ],
  "outlineSkip": [
    "AXButton",
    "sr-only",
    "group/morph",
    "group/tag"
  ],
  "context": {
    "chatHistoryTokenBudget": 1000,
    "chatTermsTokenBudget": 200
  }
}
